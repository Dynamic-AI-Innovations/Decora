{
  "name": "decora",
  "version": "0.1.0",
  "private": true,
  "description": "Nigeria's first AI-powered interior design platform — monorepo root.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter=./apps/* dev",
    "dev:web": "pnpm --filter @decora/web dev",
    "dev:mobile": "pnpm --filter @decora/mobile start",
    "dev:ai": "pnpm --filter @decora/ai-service dev",
    "dev:infra": "docker compose -f infra/docker-compose.dev.yml up -d",
    "build": "pnpm -r --filter=./apps/* build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "typescript": "^5.6.0"
  }
}
