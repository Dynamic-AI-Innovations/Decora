# Decora — environment variables
# Copy to .env.local for local dev. Never commit real secrets.
# Real values live in 1Password vault: "Decora — Dev Secrets"

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Anthropic (Claude) ----
# Sonnet 4.6 for production render-pipeline LLM calls; Haiku 4.5 for cheap analysis.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PRIMARY=claude-sonnet-4-6
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001

# ---- Replicate (SDXL + ControlNet) ----
REPLICATE_API_TOKEN=
REPLICATE_SDXL_VERSION=
REPLICATE_CONTROLNET_VERSION=

# ---- Fal.ai (failover image gen) ----
FAL_API_KEY=

# ---- Paystack ----
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ---- Flutterwave (failover payments) ----
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# ---- Upstash Redis (job queue + cache) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Affiliate platforms ----
JUMIA_AFFILIATE_ID=
KONGA_AFFILIATE_ID=

# ---- Observability ----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SHARED_SECRET=

# ---- Feature flags (defaulted off in prod) ----
FEATURE_VIDEO_UPLOAD=false
FEATURE_FLOORPLAN_UPLOAD=false
FEATURE_AR_PREVIEW=false
FEATURE_PIDGIN_UI=false
